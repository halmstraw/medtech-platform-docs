{
  "routes": [
    {
      "route": "/radar",
      "redirect": "/radar/",
      "statusCode": 301
    },
    {
      "route": "/radar/",
      "rewrite": "/radar/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/radar/*",
      "/_next/*",
      "/*.{js,css,png,jpg,svg,ico,json}"
    ]
  }
}
